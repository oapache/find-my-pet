# ===========================================
# Find My Pet - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://findmypet:changeme@localhost:5432/findmypet

# ---- Auth (NextAuth v5) ----
AUTH_SECRET=generate-a-random-secret-here
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- MinIO (S3-compatible storage) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=findmypet
MINIO_BUCKET_PRIVATE=findmypet-assets

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Payment: Asaas (Brazil) ----
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

# ---- Payment: Stripe (International) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
